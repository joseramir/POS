FONT 8, "System"
BEGIN
    ICON            IDI_POS,IDC_MYICON,14,9,20,20
    LTEXT           "POS Version 3.0",IDC_STATIC,49,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 1999 - HMF Sistemas",IDC_STATIC,49,20,119,
                    8
    DEFPUSHBUTTON   "Continuar",IDOK,180,48,39,18,WS_GROUP
END


