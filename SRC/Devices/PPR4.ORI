/*   Datos de este solo modulo   */
static struct lstat_ lstatPR4;
static char *pc;                // Para explorar respuestas.
static int hPr4;                // Handler al device.
static int inTickPR4;           // Indica que el PR4 tiene ticket abierto.

/*   Cadenas especiales de control   */
#ifdef PANTACOLOR
static int prnesq[16] = {       // Esquema default de colores
	{ ROJO * 16 + BLANCO },     // Color del borde
	{ BLANCO * 16 + NEGRO },    // Titulo a ventana activa.
	{ NEGRO * 16 + BLANCO },    // Titulo a ventana inactiva.
	{ ROJO * 16 + VERDE }       // Texto contenido.
};
#else
static int prnesq[16] = {       // Esquema default de colores
	{ BLANCO * 16 + NEGRO },    // Color del borde
	{ NEGRO * 16 + BLANCO },    // Titulo a ventana activa.
	{ NEGRO * 16 + BLANCO },    // Titulo a ventana inactiva.
	{ BLANCO * 16 + NEGRO }     // Texto contenido.
};
#endif

/****************************************************************************
 ***   Interfaz de bajo nivel - Sigue las especificaciones de los documentos
 ***   "Descripcion de Comandos" y "El ECR Fiscal" emitidos por Cia HASAR.
*/

#define SEP     ''

//   Prototipos   
static char *chkdesPR4(char *s);
static void chkStatusPR4(void);
static char *getfldPR4(void);
static unsigned long gethexaPR4(void);
static void xchgPktPR4(char *);
static unsigned long getdecPR4(void);

/*   Variables de este modulo   */
#define SIZEPR4BUFF 500

static char rxBuff[SIZEPR4BUFF], txBuff[SIZEPR4BUFF], tmpBuff[SIZEPR4BUFF],
            txBuff2[SIZEPR4BUFF];

// Chequea las descripciones.
//     (Se heredo del problema del TM300, no molesta...)
// Se agrego el proceso de 'CAMBIO' de tipo de letra.
char *chkdesPR4(char *s)
{
    char *ret, cModo;

    //  Elimina caracteres extra¤os (incluye la ¥, que pena).
    ret = s;
	for( ; *s; s++)
		if(*s < ' ' || *s > 'z')
			*s = ' ';

    //   Cambia la letra si corresponde.
    s = ret;
    if(*ret == '@')
    {
        cModo = *(ret + 1);
        if(cModo == '0' || cModo == '4')
        {
            ret++;
            *ret = (cModo == '0')? 'ð': 'ô';  // 240 y 244
            strcat(ret, "ð");
        }
        else
            ret += 2;
    }
    strcpy(s, ret);
	return ret;
}

//  El paquete que se recibe como parametro lo envia al impresor. Posteriormente, queda
//  en espera de la respuesta y, cuando la recibe, chequea los resultados.
void xchgPktPR4(char *pkt)
{
    strcat(strcpy(tmpBuff, pkt), "\n");
    write(hPr4, tmpBuff, strlen(tmpBuff));
    rxBuff[0] = 0;
    read(hPr4, rxBuff, SIZEPR4BUFF);
    rxBuff[strlen(rxBuff) - 1] = 0;
    pc = rxBuff;
    lstatPR4.prnstat  = gethexaPR4();
    lstatPR4.fiscstat = gethexaPR4();
}

/***************************************************************************
 ***  Funciones de Mediano nivel para comunicarse con el PR4
*/
char *getfldPR4()         // Lee una string.
{
    char *r;
    static char fld[60];

	if(*pc == SEP) pc++;
    if(pc >= rxBuff + SIZEPR4BUFF) return "";
    for(r = fld; *pc != SEP; )
		if(pc >= rxBuff + SIZEPR4BUFF || r >= fld + 60)
			return "";
		 else
			*r++ = *pc++;
	*r = 0;
	return fld;
}

unsigned long gethexaPR4()          // Lee un nro expresado hexadecimal
{
	unsigned long res;
    char *p;

    for(p = getfldPR4(), res = 0l; isxdigit(*p); p++)
	{
		res *= 16;
		res += (*p <= '9')? (*p - '0') : (
		       (*p <= 'F')? (*p - 'A' + 10): (*p - 'a' + 10));
	}
	return res;
}

static unsigned long getdecPR4()          // Lee un nro expresado decimal
{
	unsigned long res;
    char *p;

    for(p = getfldPR4(), res = 0l; isdigit(*p); p++)
	{
		res *= 10;
		res += *p - '0';
	}
	return res;
}

int chkFiscStatPR4()
{
	char *msg;

    if((lstatPR4.fiscstat & 0x81) || (lstatPR4.fiscstat & 0x80))
		msg = "Memoria Fiscal Llena";
    else if(lstatPR4.fiscstat & 0x1)
		msg = "Error al Verificar la Memoria Fiscal";
    else if(lstatPR4.fiscstat & 0x2)
		msg = "Error al Verificar la Memoria de Trabajo (CMOS)";
    else if(lstatPR4.fiscstat & 0x40)
		msg = "Monto Total excede lo permitido por el impresor";
    else if(lstatPR4.fiscstat & 0x100)
		msg = "Memoria fiscal CASI llena. Avise al Tecnico";
    else if((lstatPR4.fiscstat & 0x800) && (lstatPR4.fiscstat & 0x2000))
		msg = "Cierre el Ticket - El impresor no admite mas renglones";
    else if((lstatPR4.fiscstat & 0x800) && !(lstatPR4.fiscstat & 0x2000))
	{
		msg = "Efectue una Zeta. El impresor asi lo requiere.";
		FiscalForceZeta = 1;
	}
	else return 0;
    #ifdef INPOS
	Alert("Error Fiscal en la Impresora", msg);
    #else
    printf("Error Fiscal en la Impresora!!!\n");
    #endif
	return 1;
}

int chkPrnStatPR4()
{
	char *msg;

    if(lstatPR4.prnstat & 0x4)
		msg = "Error / Falla de Impresora";
    else if(lstatPR4.prnstat & 8)
        msg = "Impresora Fuera de Linea (OFFLINE)";
    else if(lstatPR4.prnstat & 0x10)
        msg = "Falta Papel en la Cinta Testigo";
    else if(lstatPR4.prnstat & 0x20)
        msg = "Falta Papel en el Ticket";
    else return 0;

    #ifdef INPOS
	Alert("Error en la Impresora", msg);
    #else
    printf("Error '%s' en el TMPR4 !!!", msg);
    #endif
	return 1;
}

void chkStatusPR4()
{
    xchgPktPR4("*");
    pc = rxBuff;

    //  Completa la estructura de estado.
    lstatPR4.prnstat  = gethexaPR4();
    lstatPR4.fiscstat = gethexaPR4();
    lstatPR4.lastcomp = getdecPR4();
    lstatPR4.fecop    = getdecPR4();
    lstatPR4.horaop   = getdecPR4();
    lstatPR4.lastcie  = getdecPR4();
    lstatPR4.archi1   = getdecPR4();
    lstatPR4.archi2   = getdecPR4();
    strcpy(lstatPR4.archi3, getfldPR4());
    strcpy(lstatPR4.archi4, getfldPR4());
}

//   Queda esperando a que el PR4 este listo.
int chkPR4()
{
    for( ;; )
    {
        chkStatusPR4();
        if(chkPrnStatPR4()) continue;
        if(chkFiscStatPR4()) continue;
        break;
    }
	return 0;
}

/**************************************************************************
 ***   Funciones de mediano nivel. Son llamadas por printer.c
 *****/

int ChkPrnXonXoffPR4()
{
	while(chkPR4() == 1)
        ;
	return 0;
}

