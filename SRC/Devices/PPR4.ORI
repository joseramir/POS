/**********************************************************************
 *   LINEAS QUE MANEJAN LO FISCAL.
*/

//  Inicializa el impresor.
int InitPrinterPR4()
{
    PrintTextAllowed = 0;       // No se puede usar 'PrintText'
	return 0;
}

//   Abre la gaveta (Cajon de dinero). Utilizamos para esta tarea el dispo-
//   sitivo presente en el impresor TMPR4 para activarla.
int OpenDrwrPR4()
{
    xchgPktPR4("{");
    return 0;
}

//   Funcion que deja todo en orden al finalizar (atexit)./
void closePR4(void)
{
    close(hPr4);
}

//   Descarga en el printer todos los datos instalables.
int UpLoadPR4()
{
    int i;

    //  Establece el handler para manejar el impresor.
    hPr4 = open("fisprn", O_RDWR | O_BINARY);
    if(hPr4 < 0)
        AbEnd("No puedo abrir el dispositivo fiscal HASAR (fisprn).");
    atexit(closePR4);       // Cierra el handler al salir
    chkPR4();               // Valida la comunicacion.

    //  Capacidades del impresor
    PrinterCap = PRN_FISCAL;

    //  Mensaje!!!
    SendMsg("Espere. Cargando el impresor HASAR ...", "");
	for(i=0; i<cLinesLogo; i++)
	{
        chkdesPR4(LogoLines[i]);
        sprintf(txBuff2, "]%d%s", i+1, LogoLines[i]);
        xchgPktPR4(txBuff2);
	}
    for( ; i < 10; i++)         // Vacia las lineas no usadas.
	{
        sprintf(txBuff2, "]%d%c", i+1, '\x7f');
        xchgPktPR4(txBuff2);
	}

	//  Carga la definicion del pie del ticket !!!
	for(i=0; i<cLinesPie; i++)
	{
        chkdesPR4(LogoPie[i]);
        sprintf(txBuff2, "]%d%s", i+11, LogoPie[i]);
        xchgPktPR4(txBuff2);
	}
    for( ; i < 10; i++)         // Vacia las lineas no usadas.
	{
        sprintf(txBuff2, "]%d%c", i+11, '\x7f');
        xchgPktPR4(txBuff2);
	}

    ClearMsg();
	return 0;
}

//   Imprime un item de linea.
int PrintItemPR4()
{
	char tdes[30];

    chkdesPR4(f_des);
	if(strlen(f_des) <= 20)
		strcpy(tdes, f_des);
	 else
	 {
		memmove(tdes, f_des, 20);
		tdes[20] = 0;
	 }

    sprintf(txBuff, "B%s%.3lf%.2lf%.2lf%c%.2lf%c%c" ,
            tdes, f_mult, f_monto, (double) f_tasa / 100, f_qual,
            (double) f_variac / 100, '0', 'T');

    //   Abre el ticket, si todavia no esta abierto.
    if(!inTickPR4)
    {
        inTickPR4 = 1;
        xchgPktPR4("@TT");
        PrintClerk();
    }

    for( ;; )
    {
        xchgPktPR4(txBuff);
        if(chkPrnStatPR4()) continue;
        if(chkFiscStatPR4()) continue;
        break;
	}
	return 0;
}

//   Imprime y chequea el subtotal de la operacion.
int PrintSubtPR4()
{
	char tdes[30], pFlag;

	pFlag = char(f_tasa);
    chkdesPR4(f_des);
	if(strlen(f_des) <= 20)
		strcpy(tdes, f_des);
	else
	{
		memmove(tdes, f_des, 20);
		tdes[20] = 0;
	}

    sprintf(txBuff, "C%c%s0", pFlag, tdes);
    xchgPktPR4(txBuff);
    pc = rxBuff;

    getfldPR4();                               // Estado de la impresora.
    getfldPR4();                               // Estado fiscal.
    getfldPR4();                               // Cuenta items de linea.
    printerTot = 100.0 * atof_(getfldPR4());   // Total de mercaderia.
	return 0;
}

//   Envia un monto de pago y, alternativamente, el cierre del ticket.
int PrintMpagoPR4()
{
	char tdes[30];

    chkdesPR4(f_des);
	if(strlen(f_des) <= 25)
		strcpy(tdes, f_des);
	 else
	 {
		memmove(tdes, f_des, 25);
		tdes[25] = 0;
	 }

    sprintf(txBuff, "D%s%.2lfT0", tdes, f_monto);
    xchgPktPR4(txBuff);
	if(f_qual)
    {
        xchgPktPR4("E");
        inTickPR4 = 0;
    }
	return 0;
}

//   Envia al impresor fiscal un comando para que cancele todo el
//   ticket actualmente en curso.
int PrintCancelPR4()
{
    xchgPktPR4("DCANCELA0.00C0");
    xchgPktPR4("E");
    inTickPR4 = 0;
	return 0;
}

//   Ordena al impresor que haga una zeta diaria.
int PrintZetaPR4()
{
    xchgPktPR4("9\x1cZ");
    inTickPR4 = 0;
	return 0;
}

//   Envia un texto fiscal a la impresora.
//
int PrintTextPR4()
{
	char tdes[36];

    chkdesPR4(f_des);
	if(strlen(f_des) <= 32)
		strcpy(tdes, f_des);
	 else
	 {
		memmove(tdes, f_des, 32);
		tdes[30] = 0;
	 }

    //   Abre el ticket, si todavia no esta abierto.
    if(!inTickPR4)
    {
        inTickPR4 = 1;
        xchgPktPR4("@TT");
        PrintClerk();
    }

    sprintf(txBuff2, "A%s0", tdes);
    xchgPktPR4(txBuff2);
	return 0;
}

//   Ordena al impresor que abra un ticket no fiscal.
int OpenVoucherPR4()
{
    xchgPktPR4("H");
    return 0;
}

//   Imprime un texto NO fiscal.
int PrintVoucherPR4()
{
    chkdesPR4(f_des);
    sprintf(txBuff2, "I%s0", f_des);
    xchgPktPR4(txBuff2);
	return 0;
}

//   Cierra un ticket NO fiscal.
int CloseVoucherPR4()
{
    xchgPktPR4("J");
	return 0;
}

